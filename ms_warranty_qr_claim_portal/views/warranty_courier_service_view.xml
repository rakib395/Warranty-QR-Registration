<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_courier_service_list" model="ir.ui.view">
        <field name="name">warranty.courier.service.list</field>
        <field name="model">warranty.courier.service</field>
        <field name="arch" type="xml">
            <list string="Courier Services" editable="bottom">
                <field name="name"/>
                <field name="website_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_courier_service_form" model="ir.ui.view">
        <field name="name">warranty.courier.service.form</field>
        <field name="model">warranty.courier.service</field>
        <field name="arch" type="xml">
            <form string="Courier Service">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Sundarban Courier"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="website_url" placeholder="e.g. https://sundarbancourierltd.com/tracking?no="/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_warranty_courier_service" model="ir.actions.act_window">
        <field name="name">Courier Services</field>
        <field name="res_model">warranty.courier.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Courier Service Provider!
            </p>
        </field>
    </record>
</odoo>