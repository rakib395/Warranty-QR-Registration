<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_reject_reason_wizard_form" model="ir.ui.view">
        <field name="name">warranty.reject.reason.wizard.form</field>
        <field name="model">warranty.reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejection Reason">
                <group>
                    <field name="reason" placeholder="Please enter the reason for rejection here..." rows="4"/>
                </group>
                <footer>
                    <button name="action_reject_confirm" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_warranty_reject_reason_wizard" model="ir.actions.act_window">
        <field name="name">Reject Warranty Request</field>
        <field name="res_model">warranty.reject.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>